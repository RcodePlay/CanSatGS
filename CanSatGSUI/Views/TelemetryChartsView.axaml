<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CanSatGSUI.ViewModels"
             xmlns:views="using:CanSatGSUI.Views"
             xmlns:scottplot="using:ScottPlot.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
             x:Class="CanSatGSUI.Views.TelemetryChartsView"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="scottplot|AvaPlot">
            <Setter Property="Height" Value="250" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <!-- Toolbar: Pinned | All, help text, live controls -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,14">
            <Border Grid.Column="0" Classes="seg" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Classes="seg" Classes.on="{Binding IsPinnedGraphsView}"
                            Command="{Binding ShowPinnedGraphsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="{StaticResource StarGeometry}" Fill="{Binding $parent[Button].Foreground}" Width="12" Height="12" Stretch="Uniform" />
                            <TextBlock Text="{Binding PinnedButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="seg" Classes.on="{Binding IsAllGraphsView}"
                            Command="{Binding ShowAllGraphsCommand}" Content="{Binding AllButtonText}" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="1" Classes="help" Margin="16,0" MaxWidth="520" HorizontalAlignment="Left"
                       Text="Mouse wheel zooms, left-drag pans, middle-click fits a chart. Untick 'Follow live data' to keep your zoom while packets arrive." />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <CheckBox x:Name="FollowLiveCheckBox" IsChecked="True" Content="Follow live data"
                          ToolTip.Tip="When on, every chart rescales to show all data after each update." />
                <Button Classes="quiet" Content="Fit all" Click="OnFitAllClick" />
                <Button Classes="quiet" Content="Clear graphs" Command="{Binding ClearGraphsCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Classes="panel" IsVisible="{Binding ShowNoPinsHint}" HorizontalAlignment="Left">
                    <TextBlock Classes="help"
                               Text="No pinned graphs yet. Click the star on any graph (here under All, or on the dashboard) to pin it." />
                </Border>

                <!-- Two columns. Hidden cards (unpinned, in the Pinned view) take no space. -->
                <UniformGrid Columns="2">
                    <Border Classes="panel paper chart" IsVisible="{Binding AltitudeGraph.IsShownInGraphsTab}"
                            Classes.alert="{Binding AltitudeGraph.IsAlert}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,6">
                                <TextBlock Classes="title" Text="Altitude" />
                                <StackPanel Grid.Column="1" Classes="readout">
                                    <TextBlock Classes="figure" Text="{Binding AltitudeBarometer, StringFormat='{}{0:F1}'}" />
                                    <TextBlock Classes="u" Text="m" />
                                </StackPanel>
                                <views:PinButton Grid.Column="2" DataContext="{Binding AltitudeGraph}" />
                            </Grid>
                            <scottplot:AvaPlot x:Name="AltitudePlot" />
                        </StackPanel>
                    </Border>

                    <Border Classes="panel chart" IsVisible="{Binding TemperatureGraph.IsShownInGraphsTab}"
                            Classes.alert="{Binding TemperatureGraph.IsAlert}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,6">
                                <TextBlock Classes="title" Text="Temperature" />
                                <StackPanel Grid.Column="1" Classes="readout">
                                    <TextBlock Classes="figure" Classes.alert="{Binding TemperatureLimit.IsTripped}"
                                               Text="{Binding Temperature, StringFormat='{}{0:F1}'}" />
                                    <TextBlock Classes="u" Text="°C" />
                                </StackPanel>
                                <views:PinButton Grid.Column="2" DataContext="{Binding TemperatureGraph}" />
                            </Grid>
                            <scottplot:AvaPlot x:Name="TemperaturePlot" />
                        </StackPanel>
                    </Border>

                    <Border Classes="panel chart" IsVisible="{Binding PressureGraph.IsShownInGraphsTab}"
                            Classes.alert="{Binding PressureGraph.IsAlert}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,6">
                                <TextBlock Classes="title" Text="Pressure" />
                                <StackPanel Grid.Column="1" Classes="readout">
                                    <TextBlock Classes="figure" Classes.alert="{Binding PressureLimit.IsTripped}"
                                               Text="{Binding Pressure, StringFormat='{}{0:F2}'}" />
                                    <TextBlock Classes="u" Text="hPa" />
                                </StackPanel>
                                <views:PinButton Grid.Column="2" DataContext="{Binding PressureGraph}" />
                            </Grid>
                            <scottplot:AvaPlot x:Name="PressurePlot" />
                        </StackPanel>
                    </Border>

                    <Border Classes="panel chart" IsVisible="{Binding HumidityGraph.IsShownInGraphsTab}"
                            Classes.alert="{Binding HumidityGraph.IsAlert}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,6">
                                <TextBlock Classes="title" Text="Humidity" />
                                <StackPanel Grid.Column="1" Classes="readout">
                                    <TextBlock Classes="figure" Classes.alert="{Binding HumidityLimit.IsTripped}"
                                               Text="{Binding Humidity, StringFormat='{}{0:F1}'}" />
                                    <TextBlock Classes="u" Text="%" />
                                </StackPanel>
                                <views:PinButton Grid.Column="2" DataContext="{Binding HumidityGraph}" />
                            </Grid>
                            <scottplot:AvaPlot x:Name="HumidityPlot" />
                        </StackPanel>
                    </Border>

                    <Border Classes="panel chart" IsVisible="{Binding AccelerationGraph.IsShownInGraphsTab}"
                            Classes.alert="{Binding AccelerationGraph.IsAlert}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,6">
                                <TextBlock Classes="title" Text="Acceleration" />
                                <StackPanel Grid.Column="1" Classes="readout">
                                    <TextBlock Classes="figure" Classes.alert="{Binding AccelMagnitudeLimit.IsTripped}"
                                               Text="{Binding AccelerationMagnitude, StringFormat='{}{0:F2}'}" />
                                    <TextBlock Classes="u" Text="m/s² |a|" />
                                </StackPanel>
                                <views:PinButton Grid.Column="2" DataContext="{Binding AccelerationGraph}" />
                            </Grid>
                            <scottplot:AvaPlot x:Name="AccelerationPlot" />
                        </StackPanel>
                    </Border>

                    <Border Classes="panel chart" IsVisible="{Binding AngularVelocityGraph.IsShownInGraphsTab}"
                            Classes.alert="{Binding AngularVelocityGraph.IsAlert}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,6">
                                <TextBlock Classes="title" Text="Angular Velocity" />
                                <StackPanel Grid.Column="1" Classes="readout">
                                    <TextBlock Classes="figure" Classes.alert="{Binding AngularVelocityLimit.IsTripped}"
                                               Text="{Binding OmegaZDegreesPerSecond, StringFormat='{}{0:F2}'}" />
                                    <TextBlock Classes="u" Text="°/s Z" />
                                </StackPanel>
                                <views:PinButton Grid.Column="2" DataContext="{Binding AngularVelocityGraph}" />
                            </Grid>
                            <scottplot:AvaPlot x:Name="AngularVelocityPlot" />
                        </StackPanel>
                    </Border>

                    <Border Classes="panel chart" IsVisible="{Binding MagneticFieldGraph.IsShownInGraphsTab}"
                            Classes.alert="{Binding MagneticFieldGraph.IsAlert}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,6">
                                <TextBlock Classes="title" Text="Magnetic Field" />
                                <StackPanel Grid.Column="1" Classes="readout">
                                    <TextBlock Classes="figure" Classes.alert="{Binding MagneticFieldLimit.IsTripped}"
                                               Text="{Binding MagneticFieldZ, StringFormat='{}{0:F2}'}" />
                                    <TextBlock Classes="u" Text="µT Z" />
                                </StackPanel>
                                <views:PinButton Grid.Column="2" DataContext="{Binding MagneticFieldGraph}" />
                            </Grid>
                            <scottplot:AvaPlot x:Name="MagneticFieldPlot" />
                        </StackPanel>
                    </Border>

                    <Border Classes="panel chart" IsVisible="{Binding AzimuthGraph.IsShownInGraphsTab}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,6">
                                <TextBlock Classes="title" Text="Azimuth (Theta)" />
                                <StackPanel Grid.Column="1" Classes="readout">
                                    <TextBlock Classes="figure" Text="{Binding Theta, StringFormat='{}{0:F2}'}" />
                                    <TextBlock Classes="u" Text="°" />
                                </StackPanel>
                                <views:PinButton Grid.Column="2" DataContext="{Binding AzimuthGraph}" />
                            </Grid>
                            <scottplot:AvaPlot x:Name="AzimuthPlot" />
                        </StackPanel>
                    </Border>

                    <Border Classes="panel chart" IsVisible="{Binding RssiGraph.IsShownInGraphsTab}"
                            Classes.alert="{Binding RssiGraph.IsAlert}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,6">
                                <TextBlock Classes="title" Text="RSSI" />
                                <StackPanel Grid.Column="1" Classes="readout">
                                    <TextBlock Classes="figure" Classes.alert="{Binding RssiLimit.IsTripped}"
                                               Text="{Binding Rssi, StringFormat='{}{0:F0}'}" />
                                    <TextBlock Classes="u" Text="dBm" />
                                </StackPanel>
                                <views:PinButton Grid.Column="2" DataContext="{Binding RssiGraph}" />
                            </Grid>
                            <scottplot:AvaPlot x:Name="RssiPlot" />
                        </StackPanel>
                    </Border>

                    <Border Classes="panel chart" IsVisible="{Binding SnrGraph.IsShownInGraphsTab}"
                            Classes.alert="{Binding SnrGraph.IsAlert}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,6">
                                <TextBlock Classes="title" Text="Signal-to-Noise Ratio" />
                                <StackPanel Grid.Column="1" Classes="readout">
                                    <TextBlock Classes="why" Text="{Binding SnrLimit.Reason}" Margin="0,0,10,0" />
                                    <TextBlock Classes="figure" Classes.alert="{Binding SnrLimit.IsTripped}"
                                               Text="{Binding Snr, StringFormat='{}{0:F0}'}" />
                                    <TextBlock Classes="u" Text="dB" />
                                </StackPanel>
                                <views:PinButton Grid.Column="2" DataContext="{Binding SnrGraph}" />
                            </Grid>
                            <scottplot:AvaPlot x:Name="SnrPlot" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CanSatGSUI.Views.CanTauriMark">
    <!--
        CanTauri logo for the header: "roundel, simple" (the right mark between 32 and 72 px)
        next to the wordmark. Both are exact vector copies of cantauri-roundel-simple.svg and
        cantauri-wordmark.svg from the CanTauri design system (lettering already outlined).
        The wordmark is drawn in cream because the header is dark.
    -->
    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Viewbox Width="42" Height="42">
            <Canvas Width="240" Height="240">
                <Ellipse Width="240" Height="240" Fill="#C1272D" />
                <Ellipse Canvas.Left="10" Canvas.Top="10" Width="220" Height="220" Fill="#171513" />
                <Canvas Width="240" Height="240">
                    <Canvas.Clip>
                        <EllipseGeometry Center="120,120" RadiusX="110" RadiusY="110" />
                    </Canvas.Clip>
                    <!-- planet with its brass limb -->
                    <Ellipse Canvas.Left="-140" Canvas.Top="168" Width="520" Height="520" Fill="#2E5C7A"
                             Stroke="#E3B04B" StrokeThickness="1.8" />
                    <!-- Centaurus: brass lines, cream four-point stars -->
                    <Path Stroke="#E3B04B" StrokeThickness="1.5" StrokeLineCap="Round"
                          Data="M 107.5,120.2 L 124.5,110.0 M 124.5,110.0 L 139.5,99.1 M 139.5,99.1 L 155.8,92.3 M 155.8,92.3 L 173.5,83.5 M 173.5,83.5 L 192.5,78.1 M 155.8,92.3 L 145.6,73.3 M 173.5,83.5 L 179.6,63.8" />

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CanSatGSUI.App"
             xmlns:local="using:CanSatGSUI"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
             <FluentTheme/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="App.BackgroundBrush" Color="#FFF0B3"/>
                    <SolidColorBrush x:Key="App.ForegroundBrush" Color="#FFF0B3"/>
                    <SolidColorBrush x:Key="App.AccentBrush" Color="#241A2C"/>
                    <SolidColorBrush x:Key="App.CardBackground" Color="#5A3B6D"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="App.BackgroundBrush" Color="#0B0A0F"/>
                    <SolidColorBrush x:Key="App.ForegroundBrush" Color="#FFF0B3"/>
                    <SolidColorBrush x:Key="App.AccentBrush" Color="#5A3B6D"/>
                    <SolidColorBrush x:Key="App.CardBackground" Color="#241A2C"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>